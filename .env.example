# ─── Hyperius Holdings site · environment ─────────────────────────────────
# This is a static site, so "env" mostly means: form endpoints + DB writes
# from the ClubRival sub-landing forms.
#
# In Vercel: set under Project Settings → Environment Variables.
# ============================================================================

# ─── Supabase (anon key, used by the ClubRival sub-landing forms) ──────────
# `anon` key is client-safe — RLS policies allow only INSERTs into the public
# form tables (waitlist_signups, brand_applications, investor_inquiries).
# Reads are blocked at the Postgres level for anon / non-admin.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Resend (optional — site-side autoresponders) ──────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=admin@hyperius.site

# ─── Formspree (legacy fallback for the parent contact form) ───────────────
FORMSPREE_FORM_ID=
